<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store edition (DISTRIBUTION=appstore). See docs/app-store/entitlements.md for why each key is here. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- On-device model download (huggingface.co), currency rates, extension API calls the user allows. -->
	<key>com.apple.security.network.client</key><true/>
	<!-- Export/import/backup panels and the iCloud Drive sync folder the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- Keeps the picked sync folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key><true/>
</dict>
</plist>
